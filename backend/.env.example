# Database connection URL (PostgreSQL)
# สำหรับใช้งานในเครื่อง หรือบนคลาวด์ เช่น Render, Supabase, Neon
DATABASE_URL="postgresql://user:password@localhost:5432/otop_db?schema=public"

# Secret key สำหรับออก JWT Token เพื่อความปลอดภัย
JWT_SECRET="otop-jwt-secret-key-2026"

# Port ที่ Backend ทำงาน (ค่าเริ่มต้น 3000)
PORT=3000
